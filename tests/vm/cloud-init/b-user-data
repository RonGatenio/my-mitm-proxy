#cloud-config
hostname: ${HOSTNAME}
ssh_pwauth: false
users:
  - name: ubuntu
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    ssh_authorized_keys:
      - ${SSH_PUBKEY}
write_files:
  - path: /etc/sysctl.d/99-mymitm.conf
    content: |
      net.ipv4.ip_forward=1
  - path: /etc/systemd/system/mymitm.service
    content: |
      [Unit]
      Description=mymitm proxy
      After=network-online.target
      [Service]
      ExecStart=/opt/mymitm/mymitm --config /opt/mymitm/mymitm.toml
      Restart=no
      [Install]
      WantedBy=multi-user.target
runcmd:
  - sysctl --system
  - mkdir -p /opt/mymitm/dumps
