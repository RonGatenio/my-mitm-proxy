# These are executed by bash (often via WSL on Windows dev boxes) and by the
# Linux CI. They MUST stay LF even when checked out on Windows with
# core.autocrlf=true — a CRLF checkout makes bash choke on `$'\r'` and mangles
# heredocs. Force LF on checkout regardless of platform.
*.sh    text eol=lf
*.py    text eol=lf
*.proto text eol=lf

# VM-harness cloud-init seed files are extensionless but are consumed by the
# Linux guest (cloud-init / QEMU). Force LF for the same reason as the scripts
# above: a CRLF checkout corrupts the embedded systemd units and YAML.
tests/vm/cloud-init/* text eol=lf
